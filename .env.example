# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MAPS_PLATFORM_API_KEY: Google Maps & Places Platform Key
MAPS_PLATFORM_API_KEY=""

# BUNDLE_SOCIAL_API_KEY: Bundle.social API key
BUNDLE_SOCIAL_API_KEY=""

# Required by the server to persist private feedback. Never expose this in Vite/client code.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
